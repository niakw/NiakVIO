  },
  "selection_policy": {
    "provider_identity": "case-insensitive canonical provider id",
    "include_disabled_providers_in_structural_validation": true,
    "include_unconfirmed_providers_disabled": true,
    "content_addressed_provider_filenames": true,
    "checks_run_before_publication": true,
