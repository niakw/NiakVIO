    "minimum_manifest_curation_score": 5,
    "enabled_manifest_order": [
      "explicit or runtime-confirmed VF providers first",
      "explicit or runtime-confirmed VOSTFR providers second",
      "other French-capable providers third",
      "all remaining providers last",
      "VF/VOSTFR/French groups: resolution, health score, curation score descending",
      "other-language group: health/quality score, resolution, curation score descending"
    ],
    "representative_fixture_mode": true,
    "content_type_inference": "Canonical capability is movie|tv|anime. Anime-only publication adds only the tv launch alias; series/show/other are client input aliases normalized to tv and are never published supportedTypes. Movie transport requires canonical movie capability.",
    "manual_provider_priority": [
      "anime-sama",
      "purstream",
      "flemmix",
      "uhdmovies",
      "movieshunt",
      "zinkmovies",
      "vegamovies",
      "hindmoviez",
      "4khdhub",
      "persianstremio",
      "desiflix"
    ],
    "manual_provider_priority_scope": "Applied before language/quality ranking while preserving enabled providers before disabled providers.",
    "provider_domain_resolution": "Official hubs and public service announcements first; validated redirects and curated candidates next; bounded search fallback only in deep mode; search-only changes require repeated confirmation.",
    "provider_domain_refresh_schedule": "Daily lightweight validated refresh; strict code and stream publication remains deep-only.",
    "last_known_good_domain_retention": true,
    "published_provider_functional_fallback": true,
    "deduplicate_at_input": true,
    "duplicate_policy": "reject later duplicate DATA rows once a canonical NiakVIO provider id is materialized",
    "external_provider_repository_required": false,
    "external_provider_code_executed": false,
    "route_authority": "NiakVIO durable DATA plus validated NiakVIO recognition and runtime observations",
    "catalogue_scope_authority": "scripts/current_provider_scope.py:projection_visible_provider_ids",
    "executable_scope_authority": "scripts/current_provider_scope.py:projection_active_provider_ids",
    "catalogue_cardinality_policy": "derived-never-frozen",
    "stream_multiplicity_policy": "coverage-before-final-cap",
    "stream_dedupe_identity": "url+required_request_headers",
    "first_playable_stream_ends_discovery": false,
    "minimum_effective_height_authority": "health-config.json:activation.minimum_effective_height",
    "language_evidence_authority": "health-config.json activation plus observed stream/player metadata",
    "activation_authority": "providers/ vs provider-disabled/ lifecycle plus explicit proof-driven onboarding/reactivation transactions",
    "quick_deep_mutation_authority": false
  },
