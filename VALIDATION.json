{
  "schema_version": 67,
  "release": "dynamic",
  "release_authority": "manifest.json:version",
  "candidate_track": "main",
  "purpose": "Current NiakVIO validation contract: Provider v3 projection-union authority, fail-closed Core ownership, five first-class Nuvio Labs, adaptive recent fixture sampling, repair separation and cache-safe publication.",
  "catalogue": {
    "cardinality_policy": "derived-never-frozen",
    "global_visible_authority": "scripts/current_provider_scope.py:visible_provider_ids",
    "global_active_authority": "scripts/current_provider_scope.py:active_provider_ids",
    "projection_visible_authority": "scripts/current_provider_scope.py:projection_visible_provider_ids",
    "projection_active_authority": "scripts/current_provider_scope.py:projection_active_provider_ids",
    "projection_runtime_visible_authority": "scripts/current_provider_scope.py:projection_runtime_visible_provider_ids",
    "pending_authority": "scripts/current_provider_scope.py:pending_provider_ids",
    "france_only_authority": "provider_catalog.json:projections general=false,vf=true",
    "france_only_first_class": true,
    "historical_archive_provider_objects": 50,
    "historical_archive_authority": "provider-old/",
    "native_lab_scope_authority": "scripts/current_provider_scope.py:projection_active_provider_ids",
    "native_transport_source": "manifest-hub46.json",
    "native_transport_manifest": "native-hub46/manifest.json",
    "disabled_and_pending_rows_remain_auditable": true
  },
  "native_sampling": {
    "authority": ".github/triggers/rotating-popular-corpus.json",
    "global_lists": [
      "movie",
      "tv",
      "anime"
    ],
    "reserve_size_per_lane": 32,
    "minimum_year": 2010,
    "maximum_year_policy": "current_year_minus_1",
    "initial_fixtures_per_lane": 1,
    "fixed_batch": false,
    "rotate_only_on_clean_zero_streams": true,
    "positive_stops_rotation": true,
    "technical_error_stops_and_reports": true,
    "identity_contradiction_stops_and_reports": true,
    "historical_targeted_fixture_authority": ".github/triggers/nuvio-client-lab.json"
  },
  "native_platforms": [
    "TVAndroid",
    "MobileAndroid",
    "MobileIOS",
    "DesktopMACOS",
    "DesktopWindows"
  ],
  "native_transport": {
    "source_builder": "scripts/generate_hub46_manifest.py",
    "pinned_builder": "scripts/build_hub46_native_manifest.py",
    "scope": "Global+France active projection union",
    "provider_bytes_pinned_to_immutable_sha": true,
    "provider_urls_are_absolute": true,
    "legacy_hub46_matrix_is_current_scope_authority": false,
    "coverage_gate": "scripts/gate_native_declared_provider_matrix.py",
    "current_status": "derived-from-current-projections"
  },
  "native_prebuild_cache": {
    "enabled_for_future_runs": true,
    "exact_client_sha_keyed": true,
    "permissive_restore_keys": false,
    "runtime_and_matrix_gates_still_execute": true
  },
  "core_contract": {
    "timeout_seconds": 25,
    "runtime_timer_compatibility_owner": "Core",
    "http_403_policy": "fail_closed",
    "stale_navigation_result_reinjection": false,
    "stream_sanitizer": "strict_v10",
    "wrong_media_is_failure": true,
    "clean_zero_is_not_automatic_provider_failure": true,
    "media_identity_required_for_positive_proof": true
  },
  "checks": {
    "node_provider_worker_syntax": true,
    "python_compile_scripts": true,
    "provider_core_runtime_ownership": true,
    "desktop_runtime_without_host_timers": true,
    "native_projection_union_transport": true,
    "native_pinned_blob_integrity": true,
    "native_adaptive_catalog_contract": true,
    "domain_refresh_transaction_v2_contract": true,
    "route_override_schema": true,
    "route_regression_self_test": true,
    "published_override_regressions": true,
    "reverse_rebuild_required": true,
    "release_integrity_required": true
  },
  "domain_refresh": {
    "authority": "scripts/domain_refresh_transaction_v2.py",
    "mutation_scope": "validated structured CONFIG and linked domain derivatives only",
    "provider_base_and_core_bytes_must_remain_invariant": true,
    "authoritative_hub_resolution_not_vetoed_by_runner_403": true,
    "fail_closed_on_cycles_or_out_of_scope_mutation": true
  },
  "repair": {
    "certain_regression_definition": "upstream positive for the same work/lane while NiakVIO is non-positive",
    "clean_catalogue_miss_action": "resample",
    "technical_unresolved_action": "diagnose",
    "batch_policy": "fail-closed quarantine: failed providers are isolated and the workspace is reset before retrying survivors",
    "final_candidate_requires_recent_corpus_parity": true,
    "minimizer_stage": "after functional/provider/Core stabilization"
  },
  "route_observability": {
    "fields": [
      "stage",
      "host",
      "method",
      "path_pattern",
      "status"
    ],
    "query_values_redacted": true,
    "long_tokens_redacted": true,
    "raw_stream_urls_not_published": true
  },
  "route_override_policy": {
    "central_config": "provider-overrides.json",
    "provider_scoped": true,
    "automatic_global_blind_rewrite": false,
    "obsolete_statuses": [
      404,
      410
    ],
    "minimum_requests": 3,
    "obsolete_ratio": 0.75,
    "strict_gate_is_opt_in_after_fixture_validation": true
  },
  "final_certification": {
    "status": "pending_current_projection_union_five_native_lab_verdicts",
    "requires_five_native_platforms": true,
    "requires_projection_union_coverage": true,
    "requires_codeql_security_extended": true,
    "requires_npm_audit_high": true,
    "requires_fixed_point_and_reverse_rebuild": true,
    "requires_immutable_pinned_native_transport": true
  },
  "limitations": [
    "A CI IP can be blocked while a residential IP works.",
    "A sampled work is catalogue evidence, not proof for every title in a provider.",
    "Evidence from one official Nuvio client/platform does not certify another platform.",
    "A clean zero-stream result is catalogue uncertainty and must not be promoted to a provider regression without upstream-positive comparison evidence.",
    "Workflow success, CHAIN REACHED, a generated repair, or an URL alone is not playable/identity proof.",
    "The five Native Labs are authoritative only after the current Global+France active projection union has completed its declared route matrix."
  ]
}
