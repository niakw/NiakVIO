      "playback_context"
    ],
    "official_domain_hub": [
      "origin_resolution",
      "catalogue_search_resolution"
    ],
    "quarantined": []
  },
  "executionLanes": {
    "coreRepair": {
      "independent": true,
      "learningAllowed": false,
      "learnedSkillInputAllowed": false,
      "stages": [
        "source_validation",
        "provider_recognition",
        "global_invariants",
        "capability_adapter",
        "capability_engine",
        "capability_global_invariants",
        "public_bundle"
      ],
      "unknownFailureAction": "queue_for_independent_learning"
    },
    "dailyLearning": {
      "independent": true,
      "partOfCoreRepair": false,
      "requiredPublishedProviderObservationCoverage": 1,
      "anomalyHandling": "investigate_unknown_or_unresolved_cases_and_propose_core_evolution",
      "directPublication": false
    }
  },
  "providerArtifactLifecycle": {
    "model": "stable_provider_base_plus_derived_public_bundle",
    "providerBase": {
      "created": "initial_import_or_explicit_provider_source_change",
      "startsFromEmpty": false,
      "durableOwner": "provider_pipeline",
      "coreMayReplaceProviderLogic": false,
      "durableSourceNormalizationAllowed": [
        "provider_security_hardening"
      ],
      "forbiddenDerivedLayers": [
        "publication_quarantine",
        "global_core_tail",
        "runtime_domain_wrapper",
        "adaptive_domain_wrapper",
        "presentation_runtime_layers"
      ],
      "domainRoutingIsDerived": true
    },
    "coreFinalizer": {
      "mode": "verify_first",
      "verifyCommand": "python scripts/reapply_published_overrides.py --check",
      "materializeOnlyWhenStale": true,
      "noOpWhenFixedPoint": true,
      "allowedRebuildTriggers": [
        "provider_base_changed",
        "provider_capability_or_type_changed",
        "core_embedded_revision_changed",
        "security_or_presentation_contract_changed"
      ],
      "forbiddenTrigger": "core_invocation_alone"
    },
    "publicBundle": {
      "derivation": "provider_base_plus_known_core_and_capability_layers",
      "contentAddressed": true,
      "rebuildOnlyOnInputChange": true
    },
    "domainIntelligence": {
      "independentFromProviderBase": true,
      "currentOfficialSiteIsResolvedStateNotIdentity": true,
      "sources": [
        "official_hub",
        "public_telegram",
        "validated_redirect",
        "direct_candidates",
        "last_known_good_history",
        "yandex_deep_search",
        "duckduckgo_deep_fallback"
      ],
      "validation": [
        "same_provider_brand_or_explicit_allowlist",
        "dns",
        "http_redirect_chain",
        "terminal_site_or_api_role"
      ],
      "searchOnlyPromotionRequiresConsecutiveRuns": 2,
      "inconclusiveKeepsLastKnownGood": true,
      "domainChangeMayRebuildDerivedBundle": true,
      "domainChangeMayReplaceProviderLogic": false
    }
  }
}
