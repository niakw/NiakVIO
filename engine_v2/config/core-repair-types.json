{
  "schemaVersion": 4,
  "principle": "NiakVIO validates the source, recognizes the provider and its capability, applies global invariants, applies the capability engine, applies capability-global invariants, then publishes. Learning exists only to evolve this architecture when a case is not covered.",
  "pipeline": [
    {
      "stage": "source_validation",
      "role": "accept only validated NiakVIO source/provenance"
    },
    {
      "stage": "provider_recognition",
      "role": "identify provider contract and capability strategy"
    },
    {
      "stage": "global_invariants",
      "role": "apply provider-independent correctness and safety rules"
    },
    {
      "stage": "capability_adapter",
      "role": "adapt invocation semantics such as anime-to-tv without changing requested identity"
    },
    {
      "stage": "capability_engine",
      "role": "apply resolver logic for iframe, HTML, API, direct-media or equivalent strategy"
    },
    {
      "stage": "capability_global_invariants",
      "role": "apply reusable fixes shared by every provider of that strategy"
    },
    {
      "stage": "public_bundle",
      "role": "emit only output that passed the previous stages"
    }
  ],
  "evidencePolicy": {
    "monotonic": true,
    "rule": "A proven later stage can never be diagnosed as an earlier missing stage. If a player was observed, repair search/player discovery is forbidden; diagnosis must continue at terminal media, playback context, reader, identity, audio, duration or later evidence.",
    "unknownAfterKnownStage": "learning_must_evolve_current_or_later_core_stage"
  },
  "learning": {
    "role": "discover_new_solution_or_evolve_existing_core_type",
    "skillRole": "hypothesis_and_evidence_only",
    "directDurablePatchFromSkillForbidden": true,
    "providerLocalMutation": "lab_only_proof",
    "knownTypeFailure": "run_existing_core_type_then_learn_adaptation_if_still_unresolved",
    "unknownFailure": "queue_from_core_then_classify_architecture_gap_in_learning",
    "publicationAllowed": false,
    "independentFromCoreRepair": true,
    "coreRepairMayInvokeLearning": false,
    "dailyCoverageRequired": true,
    "dailyCoverageTarget": 1
  },
  "policy": {
    "workSpecificDurableFixesForbidden": true,
    "globalInvariantProviderPatchForbidden": true,
    "capabilityRepairAppliesByStrategy": true,
    "brainSkillRole": "classification_hypothesis_and_lab_exploration_only",
    "coreMutationPolicy": "proposal_only"
  },
  "failureClasses": {
    "identity_mismatch": {
      "scope": "global",
