  "activation": {
    "publish_every_discovered_provider": true,
    "include_unconfirmed_providers": true,
    "required_validation_mode": "deep",
    "respect_upstream_disabled_state": true,
    "disable_all_other_statuses": true,
    "minimum_score_enabled": 55,
    "minimum_healthy_fixtures": 1,
    "minimum_healthy_fixture_ratio": 0.34,
    "require_declared_type_coverage": true,
    "minimum_playable_streams": 1,
    "minimum_playable_fixtures": 1,
    "minimum_distinct_hosts": 1,
    "minimum_payload_verified_streams": 1,
    "minimum_effective_height": 0,
    "preferred_height": 1080,
    "minimum_bandwidth_bps_when_reported": 0,
    "accepted_audio_languages": [
      "fr",
      "en"
    ],
    "accepted_subtitle_languages": [
      "fr",
      "en"
    ],
    "anime_original_audio_languages": [
      "ja"
    ],
    "require_accepted_language_evidence": false,
    "require_reachable_accepted_subtitle_when_advertised": true,
    "allow_accepted_audio_without_subtitles": true,
    "maximum_provider_median_latency_ms": 15000,
    "maximum_stream_median_latency_ms": 12000,
    "minimum_consecutive_deep_passes": 1,
    "minimum_total_deep_passes": 1,
    "reset_stability_on_sha_change": true,
    "quality_auto_disable": false,
    "activation_gate_count": 10,
    "inconclusive_statuses": [
      "no_streams",
      "blocked",
      "provider_unreachable",
      "runtime_error",
      "reachable"
    ],
    "preserve_strict_history_on_inconclusive": true,
    "maximum_consecutive_inconclusive_deep_checks_for_strict_grace": 2,
    "manual_runtime_evidence_file": "runtime-evidence.json",
    "allow_manual_runtime_evidence_for_inconclusive_only": true,
    "manual_runtime_evidence_requires_matching_sha256": true,
    "manual_runtime_evidence_requires_upstream_enabled": true,
    "manual_runtime_evidence_never_bypasses_p2p_or_hard_failure": true,
    "allow_same_sha_historical_quality_grace": true,
    "historical_quality_grace_requires_prior_minimum_score": true,
    "historical_quality_grace_requires_prior_gates_01_and_03_to_09": true,
    "automatic_manifest_version_bump_on_payload_change": true,
    "minimum_manifest_curation_score": 5,
    "representative_fixture_mode": true,
    "optional_subtitles_do_not_block_accepted_audio": true,
    "current_deep_success_activates_without_prior_history": true,
    "preserve_enabled_on_ci_uncertain_statuses": [
      "blocked",
      "provider_unreachable",
      "runtime_error",
      "unavailable",
      "no_streams",
      "reachable",
      "degraded"
    ],
    "allow_type_scoped_activation": true
  },
  "availability": {
    "auto_disable": true,
    "auto_disable_after_hard_failures": 6,
    "auto_reenable_after_successes": 2,
    "blocked_does_not_count_as_hard_failure": true,
    "no_streams_does_not_count_as_hard_failure": true,
    "minimum_failure_window_hours": 8,
    "targeted_retry_frequency": "hourly",
    "full_check_frequency": "every 4 hours",
    "auto_disable_only_on_confirmed_media_endpoint_outage": true,
    "runtime_errors_do_not_count_as_hard_failure": true,
    "provider_search_failures_do_not_count_as_hard_failure": true
  },
  "execution_context": {
    "simulate_nuvio_browser_environment": true,
    "derive_locale_from_provider_metadata": true,
    "default_locale": "en-US",
